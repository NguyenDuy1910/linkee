generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Users & entitlements ─────────────────────────────

enum Plan {
  FREE
  PRO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bioPage        BioPage?
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  posts          Post[]
  aiSettings     AiSettings?
  aiUsage        AiUsage[]
}

// ───────────────────────────── Link in bio ─────────────────────────────

model BioPage {
  id            String   @id @default(cuid())
  userId        String   @unique
  slug          String   @unique
  displayName   String
  bio           String   @default("")
  avatarMediaId String?
  /// Validated by lib/bio.ts `themeSchema`
  theme         Json
  /// [{ platform, url }] validated by lib/bio.ts `socialLinksSchema`
  socialLinks   Json     @default("[]")
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar MediaAsset? @relation("BioAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  links  BioLink[]
}

model BioLink {
  id        String   @id @default(cuid())
  pageId    String
  title     String
  url       String
  position  Int
  isActive  Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page BioPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
}

// ───────────────────────────── Social accounts ─────────────────────────────

enum SocialProvider {
  INSTAGRAM
  FACEBOOK
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_RECONNECT
}

model SocialAccount {
  id                 String           @id @default(cuid())
  userId             String
  provider           SocialProvider
  /// Instagram professional account ID (`user_id`) or Facebook Page ID
  providerAccountId  String
  username           String?
  displayName        String
  avatarUrl          String?
  /// Instagram: BUSINESS | MEDIA_CREATOR. Facebook: PAGE
  accountType        String?
  scopes             String[]
  /// AES-256-GCM ciphertext (lib/crypto.ts). Never sent to the client.
  accessTokenEnc     String
  tokenExpiresAt     DateTime?
  tokenRefreshedAt   DateTime?
  status             ConnectionStatus @default(ACTIVE)
  statusMessage      String?
  webhooksSubscribed Boolean          @default(false)
  autoReplyEnabled   Boolean          @default(false)
  lastSyncedAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    InstagramComment[]
  postTargets PostTarget[]
  aiUsage     AiUsage[]

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ───────────────────────────── Instagram comments & replies ─────────────────────────────

enum CommentStatus {
  NEW
  REPLIED
  SKIPPED
}

model InstagramComment {
  id                String        @id @default(cuid())
  socialAccountId   String
  igCommentId       String        @unique
  igMediaId         String
  parentIgCommentId String?
  mediaCaption      String?
  mediaPermalink    String?
  mediaThumbnailUrl String?
  authorUsername    String?
  authorIgId        String?
  text              String
  commentedAt       DateTime
  status            CommentStatus @default(NEW)
  /// Set while a reply is in flight; guards against duplicate submissions.
  replyLockedAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  socialAccount SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  replies       CommentReply[]
  aiUsage       AiUsage[]

  @@index([socialAccountId, status, commentedAt])
}

enum ReplySource {
  AI
  MANUAL
  AUTO
}

enum ReplyStatus {
  DRAFT
  SENT
  FAILED
}

model CommentReply {
  id            String      @id @default(cuid())
  commentId     String
  text          String
  source        ReplySource
  status        ReplyStatus @default(DRAFT)
  /// Hash of the AI settings that produced this suggestion (cache key).
  settingsKey   String?
  model         String?
  remoteReplyId String?     @unique
  error         String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  comment InstagramComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId, createdAt])
}

// ───────────────────────────── AI ─────────────────────────────

enum BrandTone {
  FRIENDLY
  PROFESSIONAL
  PLAYFUL
}

model AiSettings {
  userId       String    @id
  tone         BrandTone @default(FRIENDLY)
  /// BCP-47 code, or "auto" to reply in the commenter's language
  language     String    @default("auto")
  brandContext String    @default("")
  /// Auto-reply skips comments containing any of these (case-insensitive)
  skipKeywords String[]  @default([])
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AiPurpose {
  SUGGESTION
  AUTO_REPLY
}

model AiUsage {
  id               String    @id @default(cuid())
  userId           String
  socialAccountId  String?
  commentId        String?
  purpose          AiPurpose
  model            String
  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal?  @db.Decimal(12, 6)
  latencyMs        Int
  success          Boolean
  error            String?
  createdAt        DateTime  @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?    @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  comment       InstagramComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ───────────────────────────── Media & publishing ─────────────────────────────

enum MediaKind {
  IMAGE
  VIDEO
}

model MediaAsset {
  id           String    @id @default(cuid())
  userId       String
  kind         MediaKind
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  /// Unguessable relative path under MEDIA_DIR; also the public URL path segment.
  storageKey   String    @unique
  originalName String?
  createdAt    DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  postMedia  PostMedia[]
  bioAvatars BioPage[]   @relation("BioAvatar")

  @@index([userId, createdAt])
}

enum PostStatus {
  DRAFT
  SUBMITTED
}

model Post {
  id          String     @id @default(cuid())
  userId      String
  caption     String     @default("")
  status      PostStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  media   PostMedia[]
  targets PostTarget[]

  @@index([userId, createdAt])
}

model PostMedia {
  postId       String
  mediaAssetId String
  position     Int

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([postId, mediaAssetId])
}

enum TargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

model PostTarget {
  id                String         @id @default(cuid())
  postId            String
  /// Null once the account is disconnected; provider/accountName keep history readable.
  socialAccountId   String?
  provider          SocialProvider
  accountName       String
  status            TargetStatus   @default(PENDING)
  remotePostId      String?
  remoteUrl         String?
  /// Instagram media container, reused on retry so a post is never created twice.
  remoteContainerId String?
  error             String?
  attempts          Int            @default(0)
  publishedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@unique([postId, socialAccountId])
  @@index([socialAccountId])
}

// ───────────────────────────── Background jobs ─────────────────────────────

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  /// Optional idempotency key (e.g. "ig-auto-reply:<commentId>")
  dedupeKey   String?   @unique
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model WorkerHeartbeat {
  id     String   @id
  seenAt DateTime
}
