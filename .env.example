# ─── Linkee configuration (local development) ──────────────────────────────────
# Copy to .env and fill in. Never commit .env. Values marked REQUIRED must be set.
# Production values live in the homelab repo: env.yaml → `stacks/linkee` (app) and
# `stacks/postgres` (LINKEE_DB_PASSWORD).

# ── Core (REQUIRED) ──
# Local dev with `docker compose up -d db` (POSTGRES_PORT below):
DATABASE_URL="postgresql://linkee:linkee@localhost:5432/linkee?schema=public"
# Public base URL, no trailing slash. OAuth redirect URIs, webhook URL and media URLs
# are derived from it. Meta requires a public HTTPS URL for media publishing + webhooks.
APP_URL="http://localhost:3000"
# openssl rand -base64 32
AUTH_SECRET=""
# openssl rand -base64 32   (AES-256-GCM key for provider access tokens; keep it stable!)
TOKEN_ENCRYPTION_KEY=""

# ── Local dev database (docker compose up -d db) ──
POSTGRES_PORT=5432

# ── Storage ──
# Uploaded media (local disk). In production: the `linkee-media` volume at /data/media.
MEDIA_DIR="./data/media"

# ── Instagram (Instagram API with Instagram Login) ──
# Setup steps: README → "Setup Instagram + Facebook".
# Meta App Dashboard → Instagram → API setup with Instagram login → Business login settings.
# Redirect URI to register: ${APP_URL}/api/social/instagram/callback
# These are the Instagram app ID/secret — not the Facebook App ID/secret below.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# ── Facebook Pages (Facebook Login) ──
# Meta App Dashboard → App settings → Basic (App ID / App secret).
# Valid OAuth Redirect URI: ${APP_URL}/api/social/facebook/callback
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v26.0"

# ── Webhooks ──
# Callback URL: ${APP_URL}/api/webhooks/instagram   Verify token: any random string you choose.
META_WEBHOOK_VERIFY_TOKEN=""

# ── OpenRouter (only AI gateway) ──
OPENROUTER_API_KEY=""
# Budget-friendly default; any OpenRouter model id works.
OPENROUTER_MODEL="google/gemini-3.1-flash-lite"
# Output cap per reply (replies are ≤ 2 sentences).
OPENROUTER_MAX_TOKENS=120
# "none" disables reasoning tokens (cheapest). Leave empty to omit the parameter.
OPENROUTER_REASONING_EFFORT="none"
OPENROUTER_TIMEOUT_MS=15000

# ── Background worker ──
# The job worker runs inside the Next.js server process. Set false to disable it.
WORKER_ENABLED=true

# ── Billing ──
# Optional link for "Upgrade" CTAs (e.g. mailto:sales@yourdomain.com). Plans are flipped with
# `npm run plan:set -- <email> PRO` until a payment provider is added.
UPGRADE_URL=""
